<% content_for :title, "Michael Gallo" %>
<% content_for :description, "Michael Gallo is a senior software engineer specializing in Go, Python, Linux, AWS, and scalable backend systems." %>

<div class="page-content">
  <div>
    <div class="profile-page">
      <div class="wrapper">
        <div class="page-header page-header-small" filter-color="green">
          <div class="page-header-image" data-parallax="true"
            style="background-image: url('<%= asset_path("cc-bg-1.webp") %>')">
          </div>
          <div class="container">
            <div class="content-center">
              <div class="cc-profile-image"><a href="#"><%= image_tag "profile.webp", alt: "Michael Gallo" %></a></div>
              <div class="h2 title">Michael Anthony Gallo</div>
              <p class="category text-white">Golang, Python, Linux, AWS</p>
              <%= link_to "Resume", asset_path("Michael-Gallo-Resume.pdf"), class: "btn btn-primary mr-2", data: { aos: "zoom-in", aos_anchor: "data-aos-anchor" } %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="section" id="about">
      <div class="container">
        <div class="card" data-aos="fade-up" data-aos-offset="10">
          <div class="row">
            <div class="col-lg-6 col-md-12">
              <div class="card-body">
                <div class="h4 mt-0 title">About</div>
                <p>I am Michael Gallo. Senior Software Engineer with ~6 years of experience designing and developing
                  scalable solutions within the e-commerce and banking sectors. Proven expertise in Golang, Python,
                  and Linux with demonstrated leadership in mentoring junior engineers. Most recently, designed and
                  implemented an automated integration testing plan and Jenkins pipeline for a federated Golang
                  GraphQL Gqlgen data mesh, significantly improving testing efficiency for a top 15 bank.
                </p>
              </div>
            </div>
            <div class="col-lg-6 col-md-12">
              <div class="card-body">
                <div class="h4 mt-0 title">Basic Information</div>
                <div class="row mt-3">
                  <div class="col-sm-4"><strong class="text-uppercase">Location:</strong></div>
                  <div class="col-sm-8">Arlington, VA</div>
                </div>
                <div class="row mt-3">
                  <div class="col-sm-4"><strong class="text-uppercase">Email:</strong></div>
                  <div class="col-sm-8"><a href="mailto:me@michaelgallo.dev">me@michaelgallo.dev</a></div>
                </div>
                <div class="row mt-3">
                  <div class="col-sm-4"><strong class="text-uppercase">Phone:</strong></div>
                  <div class="col-sm-8"><a href="tel:+17327427313">732-742-7313</a></div>
                </div>
                <div class="row mt-3">
                  <div class="col-sm-4"><strong class="text-uppercase">LinkedIn:</strong></div>
                  <div class="col-sm-8">
                    <a href="https://www.linkedin.com/in/michael-gallo-8193669a/">linkedin.com/in/michael-gallo-8193669a/</a>
                  </div>
                </div>
                <div class="row mt-3">
                  <div class="col-sm-4"><strong class="text-uppercase">GitHub:</strong></div>
                  <div class="col-sm-8">
                    <a href="https://github.com/Michael-Gallo/">github.com/Michael-Gallo/</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="section" id="skill">
      <div class="container">
        <div class="h4 text-center mb-4 title">Professional Skills</div>
        <div class="card" data-aos="fade-up" data-aos-anchor-placement="top-bottom">
          <div class="card-body">
            <% @skills.each_slice(2) do |skill_row| %>
              <div class="row">
                <% skill_row.each do |skill| %>
                  <div class="col-md-6">
                    <div class="progress-container progress-primary">
                      <span class="progress-badge"><%= skill[:name] %></span>
                      <div class="progress">
                        <div class="progress-bar progress-bar-primary" data-aos="progress-full" data-aos-offset="10"
                          data-aos-duration="2000" role="progressbar" aria-valuenow="<%= skill[:proficiency] %>"
                          aria-valuemin="0" aria-valuemax="100" style="width: <%= skill[:progress_width] %>%;"></div><span class="progress-value"><%= skill[:proficiency] %>%</span>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <div class="section" id="portfolio">
      <div class="container">
        <div class="row">
          <div class="col-md-6 ml-auto mr-auto">
            <div class="h4 text-center mb-4 title">Portfolio</div>
          </div>
        </div>
        <div class="tab-content gallery mt-5">
          <div class="tab-pane active" id="web-development">
            <div class="row portfolio-row">
              <% @portfolio_items.each do |item| %>
                <div class="col-12 col-md-6 col-lg-4 mb-4">
                  <div class="cc-porfolio-image img-raised" data-aos="fade-up" data-aos-anchor-placement="top-bottom">
                    <%= link_to item[:url], target: "_blank", rel: "noopener" do %>
                      <figure class="cc-effect"><%= image_tag item[:image], item[:image_options] %>
                        <figcaption>
                          <div class="h4"><%= item[:name] %></div>
                          <p><%= item[:description] %></p>
                        </figcaption>
                      </figure>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="section" id="experience">
      <div class="container cc-experience">
        <div class="h4 text-center mb-4 title">Work Experience</div>
        <% @experiences.each do |experience| %>
          <div class="card">
            <div class="row">
              <div class="col-md-3 bg-primary" data-aos="fade-right" data-aos-offset="50" data-aos-duration="500">
                <div class="card-body cc-experience-header">
                  <p><%= experience[:dates] %></p>
                  <div class="h5"><%= experience[:company] %></div>
                </div>
              </div>
              <div class="col-md-9" data-aos="fade-left" data-aos-offset="50" data-aos-duration="500">
                <div class="card-body">
                  <div class="h5"><%= experience[:title] %></div>
                  <p><%= safe_join(experience[:description], tag.br + tag.br) %></p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <div class="section" id="certifications">
      <div class="h4 text-center mb-4 title">Certifications</div>
      <div class="container" style="max-width: 50%;">
        <div class="row justify-content-center">
          <div class="col-md-6 col-lg-4 col-sm-6 mb-4">
            <a href="https://www.credential.net/45b2302b-cbc8-451f-9067-2b26e42a0763" target="_blank" rel="noopener">
              <%= image_tag "gcp-ace.webp", class: "img-fluid", alt: "GCP ACE Certification" %>
            </a>
          </div>
          <div class="col-md-6 col-lg-4 col-sm-6 mb-4">
            <a href="https://www.credly.com/badges/3fef3816-2559-4d08-bb71-123a2a652292" target="_blank" rel="noopener">
              <%= image_tag "aws-certified-developer-associate.webp", class: "img-fluid", alt: "AWS Certified Developer Associate" %>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
