<% content_for :title, "Blog | Michael Gallo" %>
<% content_for :description, "Writing from Michael Gallo on software engineering, systems, and lessons from building backend services." %>

<div class="page-content blog-page">
  <div class="section">
    <div class="container">
      <p class="mb-4"><%= link_to "Back to portfolio", root_path, class: "btn btn-primary btn-round" %></p>
      <div class="h4 text-center mb-4 title">Blog</div>

      <% if @posts.any? %>
        <% @posts.each do |post| %>
          <article class="card" data-aos="fade-up">
            <div class="card-body">
              <p class="category"><%= post.published_on.to_fs(:long) %></p>
              <h1 class="h4 mt-0 title"><%= link_to post.title, blog_post_path(post.slug) %></h1>
              <p><%= post.description %></p>
              <% if post.tag_list.any? %>
                <p class="blog-tags">
                  <% post.tag_list.each do |tag| %>
                    <span class="badge badge-primary"><%= tag %></span>
                  <% end %>
                </p>
              <% end %>
              <%= link_to "Read post", blog_post_path(post.slug), class: "btn btn-primary btn-round" %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="card">
          <div class="card-body">
            <p>No posts have been published yet.</p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
