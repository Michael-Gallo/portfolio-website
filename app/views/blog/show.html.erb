<% content_for :title, "#{@post.title} | Michael Gallo" %>
<% content_for :description, @post.description %>
<% content_for :og_title, @post.title %>
<% content_for :og_description, @post.description %>
<% content_for :og_type, "article" %>
<% content_for :canonical_url, blog_post_url(@post.slug) %>
<% content_for :head do %>
  <meta property="article:published_time" content="<%= @post.published_on.iso8601 %>">
<% end %>

<div class="page-content blog-page">
  <div class="section">
    <div class="container">
      <article class="card" data-aos="fade-up">
        <div class="card-body blog-post">
          <p class="category"><%= @post.published_on.to_fs(:long) %></p>
          <h1 class="h3 mt-0 title"><%= @post.title %></h1>
          <p class="lead"><%= @post.description %></p>

          <% if @post.tag_list.any? %>
            <p class="blog-tags">
              <% @post.tag_list.each do |tag| %>
                <span class="badge badge-primary"><%= tag %></span>
              <% end %>
            </p>
          <% end %>

          <div class="blog-post-body">
            <%= sanitize @post.html %>
          </div>

          <p class="mt-4">
            <%= link_to "Back to all posts", blog_path, class: "btn btn-primary btn-round" %>
            <%= link_to "Back to portfolio", root_path, class: "btn btn-primary btn-round" %>
          </p>
        </div>
      </article>
    </div>
  </div>
</div>
