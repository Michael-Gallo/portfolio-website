<!DOCTYPE html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title><%= content_for(:title) || "Michael Gallo" %></title>
    <meta name="description" content="<%= content_for(:description) || "Michael Gallo's software engineering portfolio and blog." %>">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Michael Gallo">
    <meta name="mobile-web-app-capable" content="yes">
    <meta property="og:title" content="<%= content_for(:og_title) || content_for(:title) || "Michael Gallo" %>">
    <meta property="og:description" content="<%= content_for(:og_description) || content_for(:description) || "Michael Gallo's software engineering portfolio and blog." %>">
    <meta property="og:type" content="<%= content_for(:og_type) || "website" %>">
    <link rel="canonical" href="<%= content_for(:canonical_url) || request.original_url %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="alternate" type="application/atom+xml" title="Michael Gallo Blog" href="<%= feed_url %>">

    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700,200" rel="stylesheet">
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css" rel="stylesheet">
    <%= stylesheet_link_tag "aos", "bootstrap.min", "main", "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <noscript>
      <style>
        [data-aos] {
          opacity: 1 !important;
          transform: translate(0) scale(1) !important;
        }
      </style>
    </noscript>
  </head>

  <body id="top">
    <header>
      <div class="profile-page sidebar-collapse">
        <nav class="navbar navbar-expand-lg fixed-top bg-primary <%= "navbar-transparent" if current_page?(root_path) %>" color-on-scroll="400">
          <div class="container">
            <div class="navbar-translate">
              <%= link_to "Michael Gallo", root_path, class: "navbar-brand", rel: "tooltip" %>
              <button class="navbar-toggler navbar-toggler" type="button" data-toggle="collapse" data-target="#navigation"
                aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation"><span
                  class="navbar-toggler-bar bar1"></span><span class="navbar-toggler-bar bar2"></span><span
                  class="navbar-toggler-bar bar3"></span></button>
            </div>
            <div class="collapse navbar-collapse justify-content-end" id="navigation">
              <ul class="navbar-nav">
                <li class="nav-item"><%= link_to "About", root_path(anchor: "about"), class: "nav-link smooth-scroll" %></li>
                <li class="nav-item"><%= link_to "Skills", root_path(anchor: "skill"), class: "nav-link smooth-scroll" %></li>
                <li class="nav-item"><%= link_to "Portfolio", root_path(anchor: "portfolio"), class: "nav-link smooth-scroll" %></li>
                <li class="nav-item"><%= link_to "Experience", root_path(anchor: "experience"), class: "nav-link smooth-scroll" %></li>
                <li class="nav-item"><%= link_to "Blog", blog_path, class: "nav-link" %></li>
              </ul>
            </div>
          </div>
        </nav>
      </div>
    </header>

    <%= yield %>

    <footer class="footer">
      <p>&copy; Creative CV. All rights reserved.<br>Design - <a class="credit" href="https://templateflip.com"
          target="_blank">TemplateFlip</a><br>ICS icon by <a class="credit"
          href="https://www.flaticon.com/free-icon/ics-format_2306102" target="_blank" rel="noopener">Flaticon</a></p>
    </footer>
    <%= javascript_include_tag "jquery.3.2.1.min", "popper.min", "bootstrap.min", "now-ui-kit", "aos", "main", "data-turbo-track": "reload" %>
  </body>
</html>
