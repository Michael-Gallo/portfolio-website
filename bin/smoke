#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
rm -rf public resources/_gen

hugo --minify --gc

assert_exists() {
  [ -f "$1" ] || { echo "FAIL: $1 not found" >&2; exit 1; }
}
assert_contains() {
  grep -q "$2" "$1" || { echo "FAIL: $1 missing '$2'" >&2; exit 1; }
}

assert_exists public/index.html
assert_contains public/index.html "Michael Anthony Gallo"
assert_contains public/index.html "Golang, Python, Linux, AWS"
assert_exists public/blog/why-leave-proton/index.html
assert_contains public/blog/why-leave-proton/index.html "ProtonMail"
assert_exists public/index.xml
assert_contains public/index.xml "Why I left Proton"
assert_exists public/sitemap.xml

echo "All checks passed."
