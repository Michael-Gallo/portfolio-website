#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
rm -rf public resources/_gen

hugo --minify --gc

assert_exists() {
  [ -f "$1" ] || { echo "FAIL: $1 not found" >&2; exit 1; }
}
assert_contains() {
  grep -q "$2" "$1" || { echo "FAIL: $1 missing '$2'" >&2; exit 1; }
}
assert_not_contains() {
  grep -q "$2" "$1" && { echo "FAIL: $1 unexpectedly contains '$2'" >&2; exit 1; } || true
}

assert_exists public/index.html
assert_contains public/index.html "Michael Anthony Gallo"
assert_contains public/index.html "Senior Software Engineer"
assert_contains public/index.html "July 2021 – Present"
assert_contains public/index.html "April 2026 – August 2026"
assert_contains public/index.html "Tech Lead, GraphQL Data Mesh"
assert_contains public/index.html "Batcom LLC"
assert_contains public/index.html "Python Developer"
assert_contains public/index.html "simpleical"
assert_contains public/index.html "Golang"
assert_contains public/index.html "aria-valuenow=100"
assert_contains public/index.html "progress-bar"
assert_not_contains public/index.html "Ansible"
assert_exists public/images/Michael-Gallo-Resume.pdf
assert_exists public/blog/why-leave-proton/index.html
assert_contains public/blog/why-leave-proton/index.html "ProtonMail"
assert_exists public/index.xml
assert_contains public/index.xml "Why I left Proton"
assert_exists public/sitemap.xml

echo "All checks passed."
